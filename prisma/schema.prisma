generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  published
  archived
}

enum AnalyticsEvent {
  view
  add_to_cart
  like
}

enum OrderStatus {
  pending
  confirmed
  cancelled
}

enum OrderChannel {
  whatsapp
  dashboard
  api
}

model Product {
  id         String        @id
  nameFr     String
  nameEn     String
  nameTr     String
  categoryFr String
  categoryEn String
  categoryTr String
  price      Int?
  currency   String
  images     String[]
  status     ProductStatus @default(published)
  tags       String[]
  stock      Int           @default(0)
  views      Int           @default(0)
  postedAt   DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  analytics  Analytics[]
}

model StoreConfig {
  id              String        @id @default("main")
  nameFr          String
  nameEn          String
  nameTr          String
  categoryFr      String
  categoryEn      String
  categoryTr      String
  descriptionFr   String
  descriptionEn   String
  descriptionTr   String
  locationCity    String
  locationCountry String
  locationFr      String
  locationEn      String
  locationTr      String
  email           String
  phone           String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  openingHours    OpeningHour[]
}

model OpeningHour {
  id            Int         @id @default(autoincrement())
  day           String      @unique
  order         Int
  labelFr       String
  labelEn       String
  labelTr       String
  opensAt       Int
  closesAt      Int
  storeConfigId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  storeConfig   StoreConfig @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)
}

model Analytics {
  id         BigInt         @id @default(autoincrement())
  event      AnalyticsEvent
  locale     String?
  productId  String?
  createdAt  DateTime       @default(now())

  product    Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([event])
  @@index([productId])
}

model Order {
  id          BigInt       @id @default(autoincrement())
  items       Json
  totalAmount Int?
  status      OrderStatus  @default(pending)
  channel     OrderChannel @default(whatsapp)
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
