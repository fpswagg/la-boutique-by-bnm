# PostgreSQL for the app (Next.js + PrismaPg in src/lib/db.ts).
DATABASE_URL="postgresql://user:password@localhost:5432/la_boutique?schema=public"
# Direct URL for Prisma CLI (migrate, db push, introspect) — prisma.config.ts datasource.url in v7.
# Use the same URL as DATABASE_URL unless you sit behind a pooler.
DIRECT_URL="postgresql://user:password@localhost:5432/la_boutique?schema=public"
DASHBOARD_PASSWORD="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# SA Storage (https://sastorage.fpswagg.site) — token from SA Storage dashboard → API tokens
SA_STORAGE_URL="https://sastorage.fpswagg.site"
SA_STORAGE_TOKEN="sa_your_token_here"
