# Pooled URL for the app (Next.js + PrismaPg in src/lib/db.ts). Use the Transaction pooler (port 6543) + ?pgbouncer=true — not Session mode (5432), or static builds can hit EMAXCONNSESSION.
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"# Direct URL for Prisma CLI (migrate, db push, introspect) — prisma.config.ts datasource.url in v7.
DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-region.supabase.com:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DASHBOARD_PASSWORD="replace-with-a-long-random-secret"
SUPABASE_STORAGE_BUCKET="product-images"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Sawabo webhook (bot endpoint + secrets — see docs/SAWABO_WEBHOOK_API.md)
SAWABO_BOT_BASE_URL="https://your-bot.example.com"
SAWABO_WEBHOOK_BASE_URL=""
SAWABO_SESSION_KEY="your-session-key"
SAWABO_WEBHOOK_SECRET="your-64-char-hex-secret"
SAWABO_CALLBACK_URL=""
SAWABO_CALLBACK_SECRET=""
SAWABO_ENABLED="true"
SAWABO_MAX_REQUESTS_PER_HOUR="60"
SAWABO_DEFAULT_GROUP_IDS=""
