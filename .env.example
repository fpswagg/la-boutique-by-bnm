# The site has no database or storage of its own: everything comes from SSS.
# Business in SSS (slug or id)
SSS_STORE_SLUG=la-boutique-by-bnm
SSS_API_URL=https://sss-api.fpswagg.site
# Business API key (SSS > Paramètres > API): catalogue, orders from the cart, views
SSS_API_KEY=
# Seconds the catalogue is cached (min 30)
SSS_REVALIDATE=300
# POST /api/revalidate with this secret to refresh at once
REVALIDATE_SECRET=
# Public address of the site (OAuth redirect: SITE_URL/auth/sss/callback)
SITE_URL=http://localhost:3000
# Dashboard: "Sign in with SSS" (OAuth app of the business)
SSS_OAUTH_CLIENT_ID=
SSS_OAUTH_CLIENT_SECRET=
SSS_OAUTH_SCOPE=profile email business
# 32+ characters: encrypts the session cookie
SESSION_SECRET=
SSS_APP_URL=https://sss.fpswagg.site
